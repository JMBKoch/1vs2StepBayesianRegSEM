@article{liang_regularized_2020,
	title = {Regularized {Structural} {Equation} {Modeling} to {Detect} {Measurement} {Bias}: {Evaluation} of {Lasso}, {Adaptive} {Lasso}, and {Elastic} {Net}},
	volume = {27},
	issn = {1070-5511, 1532-8007},
